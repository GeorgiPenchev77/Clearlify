{
    "name": "Clearlify",
    "description": "Use AI to help you understand better what you are reading",
    "version": "1.0.0",
    "manifest_version": 3,
    "permissions": ["scripting", "tabs"],
    "action": {
        "default_popup": "index.html",
        "default_icon": "assets/icon.png"
    },
    "content_scripts": [
        {
            "js": ["src/scripts/greeting.js"],
            "matches": ["<all_urls>"],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "128": "assets/icon.png"
    }
}